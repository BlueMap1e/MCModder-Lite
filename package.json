{
  "name": "mcmodder-lite",
  "private": true,
  "version": "2.4.1-lite.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:config": "eslint eslint.config.ts eslint-local-rules vite.config.ts prettier.config.ts lint-staged.config.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src eslint.config.ts eslint-local-rules vite.config.ts prettier.config.ts lint-staged.config.ts",
    "verify": "npm run lint && npm run lint:config && npm run format:check",
    "check": "node scripts/release-gate.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:security": "node scripts/security-smoke.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/codemirror": "^5.60.17",
    "@types/jquery": "^2.0.68",
    "@types/jquery.cookie": "^1.4.36",
    "@types/js-beautify": "^1.14.3",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "codemirror": "^5.65.20",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "js-beautify": "^1.15.4",
    "lint-staged": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.9",
    "systemjs": "^6.15.1",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.3",
    "vite-plugin-monkey": "^7.1.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "pinyin-match": "^1.2.10",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.4.0",
    "vue-component-type-helpers": "^3.3.12"
  }
}
